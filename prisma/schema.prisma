generator client {
  provider = "prisma-client"
  output   = "../packages/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  KHR
  USD
}

enum UserRole {
  ADMIN
  BUYER
  SELLER
}

enum OtpChannel {
  EMAIL
  PHONE
}

enum OtpPurpose {
  LOGIN
}

enum KycStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SellerRiskTier {
  LOW
  MED
  HIGH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VideoPostStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  FAILED
  PUBLISHED
  ARCHIVED
}

enum VideoPostModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PaymentMethod {
  COD
  KHQR
  PAYWAY
  TOANCHET
  WING
}

enum PaymentProvider {
  COD
  BAKONG
  PAYWAY
  TOANCHET
  WING
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum OrderState {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  SELLER_CONFIRMED
  PACKED
  HANDED_TO_CARRIER
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderEventType {
  CREATED
  STATE_CHANGED
  PAYMENT_CAPTURED
  SELLER_CONFIRMED
  PACKED
  HANDED_TO_CARRIER
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  NOTE_ADDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  HANDED_TO_CARRIER
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

enum ShipmentEventSource {
  MANUAL
  PROVIDER
  SYSTEM
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum PayoutBatchStatus {
  DRAFT
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum DisputeReason {
  NOT_RECEIVED
  DAMAGED
  NOT_AS_DESCRIBED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  REFUND_APPROVED
  REJECTED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationKind {
  FOLLOW_SELLER
  SAVED_PRODUCT_BACK_IN_STOCK
  ORDER_UPDATE
  CAMPAIGN_DROP
  PRODUCT_APPROVED
  VIDEO_POST_APPROVED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum CouponType {
  PERCENT
  AMOUNT
}

enum CouponScope {
  ORDER
  PRODUCT
  BUNDLE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  ARCHIVED
}

enum CampaignSlotType {
  FEED_BOOST
  PINNED_POST
  FEATURED_DROP
}

enum DeepLinkTargetType {
  POST
  PRODUCT
  ORDER
  SELLER
}

model User {
  id                      String                   @id @default(cuid())
  email                   String?                  @unique
  phone                   String?                  @unique
  fullName                String
  passwordHash            String?
  isActive                Boolean                  @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sellerProfile           Seller?
  cart                    Cart?
  roleAssignments         UserRoleAssignment[]
  buyerOrders             Order[]                  @relation("BuyerOrders")
  orderEvents             OrderEvent[]             @relation("OrderEventActor")
  shipmentEvents          ShipmentEvent[]          @relation("ShipmentEventActor")
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  checkoutKeys            CheckoutIdempotency[]
  productReviews          ProductReview[]
  savedProducts           SavedProduct[]
  followedSellers         FollowedSeller[]
  notificationPreferences NotificationPreference[]
  notifications           UserNotification[]
  deepLinkEvents          DeepLinkEvent[]
  couponRedemptions       CouponRedemption[]
}

model OtpChallenge {
  id          String     @id @default(cuid())
  identifier  String
  channel     OtpChannel
  purpose     OtpPurpose @default(LOGIN)
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  lastSentAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([identifier, channel, purpose])
  @@index([expiresAt])
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  key             String   @unique
  hits            Int      @default(0)
  windowStartedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserRoleAssignment {
  userId    String
  role      UserRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Seller {
  id                  String           @id @default(cuid())
  userId              String           @unique
  slug                String           @unique
  displayName         String
  legalName           String?
  businessDescription String?
  supportEmail        String?
  supportPhone        String?
  defaultCurrency     Currency         @default(KHR)
  payoutBankName      String?
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutRoutingNumber String?
  riskTier            SellerRiskTier   @default(MED)
  kycStatus           KycStatus        @default(PENDING)
  kycReference        String?
  kycSubmittedAt      DateTime?
  kycApprovedAt       DateTime?
  kycRejectedAt       DateTime?
  kycNotes            String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products              Product[]
  documents             SellerDocument[]
  inventories           Inventory[]
  orders                Order[]
  videoPosts            VideoPost[]
  shipments             Shipment[]
  ledgerAccounts        LedgerAccount[]
  payoutBatches         PayoutBatch[]
  payoutItems           PayoutItem[]
  receivedFollowers     FollowedSeller[]
  reviewAggregate       SellerReviewAggregate?
  bundles               ProductBundle[]
  coupons               Coupon[]
  campaigns             Campaign[]
  notificationFollowers   UserNotification[]         @relation("NotificationSeller")
  productReviews          ProductReview[]

  @@index([kycStatus])
}

model SellerDocument {
  id          String    @id @default(cuid())
  sellerId    String
  type        String
  fileName    String
  contentType String
  s3Key       String    @unique
  sizeBytes   Int?
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@index([sellerId, type])
}

model Product {
  id               String                  @id @default(cuid())
  sellerId         String
  name             String
  slug             String
  description      String?
  category         String?
  sellerContact    String?
  sellerAddress    String?
  returnPolicy     String?
  status           ProductStatus           @default(DRAFT)
  moderationStatus ProductModerationStatus @default(PENDING)
  moderationNotes  String?
  publishedAt      DateTime?
  defaultCurrency  Currency                @default(KHR)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  seller           Seller                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  variants         ProductVariant[]
  videoPosts         VideoPost[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            ProductReview[]
  savedBy            SavedProduct[]
  bundleItems        ProductBundleItem[]
  postAttachments    VideoPostAttachment[]
  couponTargets      Coupon[]
  campaignSlots      CampaignSlot[]               @relation("CampaignSlotProduct")

  @@unique([sellerId, slug])
  @@index([sellerId, status])
  @@index([sellerId, moderationStatus])
}

model ProductVariant {
  id                  String      @id @default(cuid())
  productId           String
  sku                 String      @unique
  name                String
  currency            Currency?
  priceMinor          Int?
  compareAtPriceMinor Int?
  attributes          Json?
  weightGrams         Int?
  isActive            Boolean     @default(true)
  isDefault           Boolean     @default(false)
  position            Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory           Inventory?
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([productId, isActive])
  @@index([productId, position])
}

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  sellerId          String
  onHandQuantity    Int            @default(0)
  reservedQuantity  Int            @default(0)
  availableQuantity Int            @default(0)
  reorderPoint      Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  seller            Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model VideoPost {
  id                String                    @id @default(cuid())
  sellerId          String
  productId         String
  caption           String
  videoKey          String                    @unique
  posterKey         String?
  durationSec       Int?
  aspectRatio       Float?
  status            VideoPostStatus           @default(DRAFT)
  moderationStatus  VideoPostModerationStatus @default(PENDING)
  moderationNotes   String?
  processingError   String?
  processingStartedAt DateTime?
  processedAt       DateTime?
  featuredScore     Float                     @default(0)
  manualBoost       Float                     @default(0)
  isPinned          Boolean                   @default(false)
  publishedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  seller            Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product           Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attachments       VideoPostAttachment[]
  metrics           VideoPostMetricDaily[]
  campaignSlots     CampaignSlot[]            @relation("CampaignSlotVideoPost")

  @@index([sellerId, status])
  @@index([publishedAt, id])
  @@index([productId, status])
  @@index([moderationStatus, status])
}

model VideoPostAttachment {
  id          String    @id @default(cuid())
  videoPostId String
  productId   String
  position    Int       @default(0)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  videoPost   VideoPost @relation(fields: [videoPostId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([videoPostId, productId])
  @@index([videoPostId, position])
}

model VideoPostMetricDaily {
  id             String   @id @default(cuid())
  videoPostId    String
  metricDate     DateTime
  impressions    Int      @default(0)
  opens          Int      @default(0)
  productOpens   Int      @default(0)
  addToCarts     Int      @default(0)
  checkoutStarts Int      @default(0)
  conversions    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  videoPost      VideoPost @relation(fields: [videoPostId], references: [id], onDelete: Cascade)

  @@unique([videoPostId, metricDate])
  @@index([metricDate])
}

model Cart {
  id        String     @id @default(cuid())
  buyerId   String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id               String                @id @default(cuid())
  orderNumber      String                @unique
  buyerId          String
  sellerId         String
  paymentMethod    PaymentMethod         @default(COD)
  paymentReference String?
  paymentMetadata  Json?
  state            OrderState            @default(CREATED)
  currency         Currency
  subtotalMinor    Int
  shippingMinor    Int                   @default(0)
  taxMinor         Int                   @default(0)
  discountMinor    Int                   @default(0)
  totalMinor       Int
  placedAt         DateTime?
  paidAt           DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  shippingAddress  Json?
  billingAddress   Json?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  buyer            User                  @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller           Seller                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  paymentEvents    PaymentEvent[]
  shipment         Shipment?
  disputes         Dispute[]
  ledgerEntries    LedgerEntry[]
  payoutItems      PayoutItem[]
  checkoutKeys     CheckoutIdempotency[]
  reviews          ProductReview[]
  couponRedemption CouponRedemption?
  deepLinkEvents   DeepLinkEvent[]

  @@index([buyerId, createdAt])
  @@index([sellerId, state])
}

model CheckoutIdempotency {
  id             String   @id @default(cuid())
  buyerId        String
  idempotencyKey String
  requestHash    String
  orderId        String?
  responseData   Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  buyer          User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([buyerId, idempotencyKey])
  @@index([expiresAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus
  amountMinor       Int
  currency          Currency
  providerPaymentId String?         @unique
  providerReference String?
  checkoutUrl       String?
  qrPayload         String?
  instructions      String?
  metadata          Json?
  capturedAt        DateTime?
  failedAt          DateTime?
  lastReconciledAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([orderId, createdAt])
  @@index([provider, status])
  @@index([providerReference])
}

model PaymentEvent {
  id                String          @id @default(cuid())
  paymentId         String?
  orderId           String?
  provider          PaymentProvider
  providerEventId   String?
  idempotencyKey    String?
  eventType         String
  providerStatus    String
  payloadHash       String
  headersHash       String?
  signatureVerified Boolean         @default(false)
  metadata          Json?
  processedAt       DateTime?
  receivedAt        DateTime        @default(now())
  payment           Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, payloadHash])
  @@index([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@index([orderId, receivedAt])
  @@index([idempotencyKey])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  sku            String
  productName    String
  variantName    String
  quantity       Int
  unitPriceMinor Int
  subtotalMinor  Int
  currency       Currency
  metadata       Json?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  actorUserId String?
  type        OrderEventType
  fromState   OrderState?
  toState     OrderState?
  message     String?
  payload     Json?
  createdAt   DateTime       @default(now())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser   User?          @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Shipment {
  id                 String          @id @default(cuid())
  orderId            String          @unique
  sellerId           String
  status             ShipmentStatus  @default(PENDING)
  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  providerShipmentId String?         @unique
  shippedAt          DateTime?
  deliveredAt        DateTime?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller             Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  events             ShipmentEvent[]

  @@index([sellerId, status])
}

model ShipmentEvent {
  id              String              @id @default(cuid())
  shipmentId      String
  actorUserId     String?
  source          ShipmentEventSource @default(MANUAL)
  status          ShipmentStatus
  message         String?
  providerEventId String?
  metadata        Json?
  occurredAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())
  shipment        Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actorUser       User?               @relation("ShipmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, occurredAt])
  @@index([actorUserId, createdAt])
  @@index([providerEventId])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  sellerId  String?
  code      String            @unique
  name      String
  type      LedgerAccountType
  currency  Currency
  isSystem  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  seller    Seller?           @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  entries   LedgerEntry[]

  @@index([sellerId])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  accountId     String
  entryGroupKey String
  direction     LedgerDirection
  amountMinor   Int
  currency      Currency
  orderId       String?
  payoutBatchId String?
  externalRef   String?
  memo          String?
  effectiveAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  account       LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payoutBatch   PayoutBatch?    @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  payoutItems   PayoutItem[]

  @@index([accountId, effectiveAt])
  @@index([entryGroupKey])
  @@index([orderId])
  @@index([payoutBatchId])
}

model PayoutBatch {
  id               String            @id @default(cuid())
  sellerId         String
  status           PayoutBatchStatus @default(DRAFT)
  currency         Currency
  periodStart      DateTime
  periodEnd        DateTime
  grossAmountMinor Int
  feeAmountMinor   Int               @default(0)
  netAmountMinor   Int
  scheduledFor     DateTime?
  processedAt      DateTime?
  reference        String?           @unique
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  seller           Seller            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  ledgerEntries    LedgerEntry[]
  items            PayoutItem[]

  @@index([sellerId, status])
}

model PayoutItem {
  id               String      @id @default(cuid())
  payoutBatchId    String
  sellerId         String
  orderId          String?
  ledgerEntryId    String      @unique
  currency         Currency
  grossAmountMinor Int
  feeAmountMinor   Int         @default(0)
  netAmountMinor   Int
  createdAt        DateTime    @default(now())
  payoutBatch      PayoutBatch @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  seller           Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order            Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ledgerEntry      LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([payoutBatchId, createdAt])
  @@index([sellerId, createdAt])
  @@index([orderId])
}

model Dispute {
  id                  String        @id @default(cuid())
  orderId             String
  reason              DisputeReason
  status              DisputeStatus @default(OPEN)
  buyerMessage        String
  sellerResponse      String?
  adminNote           String?
  resolutionNote      String?
  requestedRefundMinor Int?
  resolvedRefundMinor Int?
  openedAt            DateTime      @default(now())
  resolvedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
}

model ProductReview {
  id           String       @id @default(cuid())
  productId    String
  sellerId     String
  buyerId      String
  orderId      String
  rating       Int
  headline     String?
  body         String?
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller       Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer        User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([buyerId, orderId, productId])
  @@index([productId, status, createdAt])
  @@index([sellerId, status, createdAt])
}

model SellerReviewAggregate {
  sellerId       String   @id
  reviewCount    Int      @default(0)
  averageRating  Float    @default(0)
  fiveStarCount  Int      @default(0)
  fourStarCount  Int      @default(0)
  threeStarCount Int      @default(0)
  twoStarCount   Int      @default(0)
  oneStarCount   Int      @default(0)
  updatedAt      DateTime @updatedAt
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model SavedProduct {
  id          String   @id @default(cuid())
  buyerId     String
  productId   String
  createdAt   DateTime @default(now())
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@index([buyerId, createdAt])
}

model FollowedSeller {
  id         String   @id @default(cuid())
  buyerId     String
  sellerId    String
  createdAt   DateTime @default(now())
  buyer      User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, sellerId])
  @@index([sellerId, createdAt])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  kind      NotificationKind
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, channel])
}

model UserNotification {
  id              String              @id @default(cuid())
  userId          String
  sellerId        String?
  kind            NotificationKind
  channel         NotificationChannel @default(IN_APP)
  title           String
  body            String
  actionUrl       String?
  metadata        Json?
  isRead          Boolean             @default(false)
  readAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller          Seller?             @relation("NotificationSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
}

model Coupon {
  id                String      @id @default(cuid())
  sellerId          String
  productId         String?
  bundleId          String?
  code              String      @unique
  title             String
  description       String?
  type              CouponType
  scope             CouponScope @default(ORDER)
  amountOffMinor    Int?
  percentOff        Float?
  minimumSubtotalMinor Int?
  startsAt          DateTime?
  endsAt            DateTime?
  maxRedemptions    Int?
  redemptionCount   Int         @default(0)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  seller            Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product           Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  bundle            ProductBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  redemptions       CouponRedemption[]

  @@index([sellerId, isActive])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  buyerId         String
  orderId         String?  @unique
  discountMinor   Int
  createdAt       DateTime @default(now())
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  buyer           User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, createdAt])
  @@index([buyerId, createdAt])
}

model ProductBundle {
  id            String   @id @default(cuid())
  sellerId      String
  slug          String
  name          String
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  items         ProductBundleItem[]
  coupons       Coupon[]

  @@unique([sellerId, slug])
  @@index([sellerId, isActive])
}

model ProductBundleItem {
  id          String        @id @default(cuid())
  bundleId    String
  productId   String
  quantity    Int           @default(1)
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bundle      ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId, position])
}

model Campaign {
  id             String         @id @default(cuid())
  sellerId       String
  slug           String
  title          String
  description    String?
  status         CampaignStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  seller         Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  slots          CampaignSlot[]

  @@unique([sellerId, slug])
  @@index([status, startsAt])
}

model CampaignSlot {
  id           String           @id @default(cuid())
  campaignId   String
  videoPostId  String?
  productId    String?
  slotType     CampaignSlotType
  position     Int              @default(0)
  boostScore   Float            @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  videoPost    VideoPost?       @relation("CampaignSlotVideoPost", fields: [videoPostId], references: [id], onDelete: SetNull)
  product      Product?         @relation("CampaignSlotProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([campaignId, slotType, position])
}

model DeepLinkEvent {
  id            String             @id @default(cuid())
  userId        String?
  orderId       String?
  targetType    DeepLinkTargetType
  targetId      String
  source        String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
