{
  "name": "khmercart",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "7.5.0",
    "jose": "^6.2.2"
  },
  "scripts": {
    "build": "prisma generate && turbo run build",
    "db:generate": "./scripts/with-local-env.sh prisma generate",
    "db:migrate": "./scripts/with-local-env.sh prisma migrate deploy && ./scripts/with-local-env.sh prisma generate",
    "db:reset": "./scripts/with-local-env.sh prisma migrate reset --force && ./scripts/with-local-env.sh prisma generate && pnpm db:seed",
    "db:seed": "./scripts/with-local-env.sh tsx prisma/seed.ts",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hygiene": "node ./scripts/check-repo-hygiene.mjs",
    "lint": "turbo run lint",
    "mobile:build:ios": "cd apps/mobile && pnpm dlx eas-cli@16.20.0 build --platform ios --profile production",
    "mobile:ios": "pnpm --filter @khmercart/mobile ios",
    "mobile:prebuild": "pnpm --filter @khmercart/mobile exec expo prebuild",
    "mobile:run:ios": "pnpm --filter @khmercart/mobile exec expo run:ios",
    "mobile:start": "pnpm --filter @khmercart/mobile start",
    "mobile:submit:ios": "cd apps/mobile && pnpm dlx eas-cli@16.20.0 submit --platform ios --profile production",
    "payments:reconcile": "./scripts/with-local-env.sh tsx scripts/reconcile-payments.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "web:dev": "pnpm --filter @khmercart/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "latest",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "next": "latest",
    "prettier": "latest",
    "prisma": "7.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "latest",
    "turbo": "2.9.3",
    "typescript": "6.0.2",
    "typescript-eslint": "latest",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "~19.1.10",
      "@types/react-dom": "~19.1.7",
      "@prisma/config>effect": "3.21.0"
    }
  }
}
