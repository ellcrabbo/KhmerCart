{
  "name": "khmercart",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "7.6.0",
    "jose": "^6.2.2"
  },
  "scripts": {
    "build": "prisma generate && turbo run build",
    "db:generate": "./scripts/with-local-env.sh prisma generate",
    "db:migrate": "./scripts/with-local-env.sh prisma migrate deploy && ./scripts/with-local-env.sh prisma generate",
    "db:reset": "./scripts/with-local-env.sh prisma migrate reset --force --skip-seed && pnpm db:seed",
    "db:seed": "./scripts/with-local-env.sh tsx prisma/seed.ts",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "payments:reconcile": "tsx scripts/reconcile-payments.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "next": "latest",
    "prettier": "latest",
    "prisma": "7.6.0",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>effect": "3.21.0"
    }
  }
}
