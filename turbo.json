{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.example",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_VERSION",
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_JWT_SECRET",
    "OTP_PROVIDER",
    "WEBHOOK_BASE_URL",
    "KYC_DOCUMENT_TYPES",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_KEY",
    "S3_SECRET",
    "S3_REGION",
    "KV_URL",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "KV_REST_API_READ_ONLY_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "@khmercart/core#build": {
      "outputs": []
    },
    "@khmercart/db#build": {
      "outputs": []
    },
    "@khmercart/ui#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
