NODE_VERSION=20
# Copy this file to .env.local for local app runtime or Vercel-linked values.
# Use .env.test.example -> .env.test for local tests and Docker-backed DB defaults.
DATABASE_URL=postgresql://khmercart:khmercart@localhost:5432/khmercart
REDIS_URL=redis://localhost:6379
SUPPORTED_CURRENCIES=KHR,USD
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,km
AUTH_JWT_SECRET=dev-auth-secret-change-me
OTP_PROVIDER=DEV_STUB
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=KhmerCart <noreply@khmercart.shop>
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_REQUEST_LIMIT=5
AUTH_OTP_REQUEST_IP_LIMIT=20
AUTH_OTP_VERIFY_LIMIT=5
AUTH_OTP_VERIFY_IP_LIMIT=20
AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800
ADMIN_SEED_EMAIL=UNSPECIFIED
SEED_ENABLED=true
SEED_ADMIN_PHONE=UNSPECIFIED
CHECKOUT_IDEMPOTENCY_TTL_SECONDS=300
ORDER_SLA_CONFIRM_MINUTES=
ORDER_SLA_SHIP_HOURS=
HOLD_DAYS_TIER_LOW=
HOLD_DAYS_TIER_MED=
HOLD_DAYS_TIER_HIGH=
PLATFORM_FEE_BPS=
PAYOUT_CSV_COLUMNS=default
CARRIERS=JNT,GRABEXPRESS,CAMBODIA_POST,OTHER
JNT_API_KEY=
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
CAMBODIA_POST_API_KEY=
PAYMENTS_ENV=local
PAYMENT_METHODS=COD,KHQR,PAYWAY,TOANCHET,WING
WEBHOOK_BASE_URL=http://localhost:3002
BAKONG_API_BASE=
BAKONG_CLIENT_ID=
BAKONG_CLIENT_SECRET=
# PayWay expects the checkout host here, not the full purchase endpoint.
# Sandbox example: https://checkout-sandbox.payway.com.kh
PAYWAY_BASE_URL=
PAYWAY_MERCHANT_ID=
# This is the PayWay "Public Key" / API key used for purchase and check-transaction HMAC signing.
PAYWAY_API_KEY=
# Optional: callback HMAC secret for x-payway-hmac-sha512 verification.
PAYWAY_WEBHOOK_SECRET=
TOANCHET_BASE_URL=
TOANCHET_MERCHANT_ID=
TOANCHET_API_KEY=
TOANCHET_WEBHOOK_SECRET=
WING_BASE_URL=
WING_MERCHANT_ID=
WING_API_KEY=
WING_WEBHOOK_SECRET=
KYC_DOCUMENT_TYPES=GOVERNMENT_ID,PASSPORT,BUSINESS_LICENSE
DISPUTE_REASONS=NOT_RECEIVED,DAMAGED,NOT_AS_DESCRIBED,OTHER
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=khmercart-kyc
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=us-east-1
POSTGRES_DB=khmercart
POSTGRES_USER=khmercart
POSTGRES_PASSWORD=khmercart
POSTGRES_PORT=5432
REDIS_PORT=6379
