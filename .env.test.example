# Copy this file to .env.test for local test and Docker-backed database workflows.
# Keep .env.local for app runtime / Vercel-linked values.
NODE_VERSION=20
DATABASE_URL=postgresql://khmercart:khmercart@localhost:5432/khmercart
REDIS_URL=redis://localhost:6379
SUPPORTED_CURRENCIES=KHR,USD
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,km
AUTH_JWT_SECRET=dev-auth-secret-change-me
OTP_PROVIDER=DEV_STUB
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=KhmerCart <noreply@khmercart.shop>
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_REQUEST_LIMIT=5
AUTH_OTP_REQUEST_IP_LIMIT=20
AUTH_OTP_VERIFY_LIMIT=5
AUTH_OTP_VERIFY_IP_LIMIT=20
AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800
ADMIN_SEED_EMAIL=UNSPECIFIED
SEED_ENABLED=true
SEED_ADMIN_PHONE=UNSPECIFIED
CHECKOUT_IDEMPOTENCY_TTL_SECONDS=300
ORDER_SLA_CONFIRM_MINUTES=
ORDER_SLA_SHIP_HOURS=
HOLD_DAYS_TIER_LOW=
HOLD_DAYS_TIER_MED=
HOLD_DAYS_TIER_HIGH=
PLATFORM_FEE_BPS=
PAYOUT_CSV_COLUMNS=default
CARRIERS=OTHER
DISPUTE_REASONS=NOT_RECEIVED,DAMAGED,NOT_AS_DESCRIBED,OTHER
POSTGRES_DB=khmercart
POSTGRES_USER=khmercart
POSTGRES_PASSWORD=khmercart
POSTGRES_PORT=5432
REDIS_PORT=6379
